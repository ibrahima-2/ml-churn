    {
      "id": 10,
      "type": "timeseries",
      "title": "Probabilité moyenne de churn (dérive)",
      "description": "Une variation durable signale un data drift possible (taux d'entraînement ~43 %)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(churn_prediction_probability_sum{job=\"ml-churn-api\"}[5m])) / sum(rate(churn_prediction_probability_count{job=\"ml-churn-api\"}[5m]))",
          "legendFormat": "probabilité moyenne",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(churn_predictions_total{job=\"ml-churn-api\",prediction=\"CHURN\"}[5m])) / sum(rate(churn_predictions_total{job=\"ml-churn-api\"}[5m]))",
          "legendFormat": "part CHURN",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
